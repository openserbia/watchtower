#
# Builder
#

FROM golang:1.27.2-alpine@sha256:85dc1069ac644ea3c527b177303a406eb3358192816cd7f9e5848eb658851673 AS builder

# Version string baked into the binary via ldflags. Pass it with
# --build-arg VERSION=$(git describe --tags); `task docker:build` does exactly
# that, so the build needs neither git nor the .git directory for versioning.
ARG VERSION=dev

# Pre download required modules to avoid redownloading at each build thanks to docker layer caching.
# Copying go.mod and go.sum ensure to invalid the layer/build cache if there is a change in module requirement
WORKDIR /watchtower
COPY go.mod .
COPY go.sum .
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . /watchtower

# The cache mounts keep Go's module cache (/go/pkg/mod: GOPATH is /go in the
# golang image) and build cache (/root/.cache/go-build) on the host between
# builds. `COPY . /watchtower` invalidates every layer below it on any source
# change, so without them each build re-downloads every module and compiles and
# tests the whole tree cold. They are not part of the image, so they never change
# what gets built; `go build` drops `-a` so the build cache can actually be used.
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
  cd /watchtower && \
  \
  GO111MODULE=on CGO_ENABLED=0 GOOS=linux go build -ldflags "-extldflags '-static' -X github.com/openserbia/watchtower/internal/meta.Version=${VERSION}" . && \
  GO111MODULE=on go test ./... -v


#
# watchtower
#

# distroless static-debian13 bundles ca-certificates + tzdata and runs as root
# (needed for Docker socket access), so only the binary needs copying.
FROM gcr.io/distroless/static-debian13:latest@sha256:3592aa8171c77482f62bbc4164e6a2d141c6122554ace66e5cc910cadb961ff0

LABEL "com.centurylinklabs.watchtower"="true"

COPY --from=builder /watchtower/watchtower /watchtower

HEALTHCHECK CMD [ "/watchtower", "--health-check"]

ENTRYPOINT ["/watchtower"]
